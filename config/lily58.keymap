#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        LeftPar {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        RightPar {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 19>;
        };

        Test {
            bindings = <&Ampersand>;
            key-positions = <42 43>;
        };

        Left_Bracket {
            bindings = <&kh_hs_tapdance>;
            key-positions = <28 29>;
        };

        Right_Bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <30 31>;
        };

        Left_Brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <40 41>;
        };

        Right_Brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <44 45>;
        };

        Caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 35>;
        };

        ToMain {
            bindings = <&to 0>;
            key-positions = <0 11>;
        };

        Underscore {
            bindings = <&Underscore>;
            key-positions = <45 46>;
        };

        Minus {
            bindings = <&kp KP_MINUS>;
            key-positions = <19 20>;
        };

        Plus {
            bindings = <&kp KP_PLUS>;
            key-positions = <15 16>;
        };

        Multiply {
            bindings = <&kp KP_MULTIPLY>;
            key-positions = <28 27>;
        };

        Divide {
            bindings = <&kp KP_SLASH>;
            key-positions = <31 32>;
        };

        Ecual {
            bindings = <&kp EQUAL>;
            key-positions = <29 30>;
        };

        MacroPass {
            bindings = <&SbDevMacroPass>;
            key-positions = <10 11>;
        };
    };

    behaviors {
        ss_hs_modmorph: ss_hs_modmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "SS_HS_MODMORPH";
            bindings = <&kp M>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        kh_hs_tapdance: kh_hs_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "KH_HS_TAPDANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        toggle_off: toggle_off {
            compatible = "zmk,behavior-key-toggle";
            label = "TOGGLE_OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    macros {
        SbDevMacroPass: SbDevMacroPass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp B &kp LS(D) &kp E &kp V &kp LS(P) &kp O &kp O &kp M &kp S &kp I &kp M &kp E &kp T &kp I &kp N5 &kp EXCL>;
            label = "SBDEVMACROPASS";
        };

        Ampersand: Shift_test {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_8 &toggle_off LEFT_ALT>;
            label = "SHIFT_TEST";
        };

        Hash: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_3 &kp KP_NUMBER_5 &toggle_off LEFT_ALT>;
            label = "NEW_MACRO";
        };

        Underscore: Underscore {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_9 &kp KP_NUMBER_5 &toggle_off LEFT_ALT>;
            label = "UNDERSCORE";
        };

        Dot: Dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_6 &toggle_off LEFT_ALT>;
            label = "DOT";
        };

        Colon: Colon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt LEFT_ALT &kp KP_NUMBER_5 &kp KP_NUMBER_8 &toggle_off LEFT_ALT>;
            label = "COLON";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Main {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC         &kp N1        &kp N2        &kp N3        &kp N4        &kp N5                        &kp N6  &kp N7  &kp N8              &kp N9   &kp N0    &kp EQUAL
&kp TAB         &kp Q         &kp W         &hrm GRAVE E  &kp R         &kp T                         &kp Y   &kp U   &kp I               &kp O    &kp P     &kp BACKSPACE
&kp LEFT_SHIFT  &kp A         &kp S         &kp D         &kp F         &kp G                         &kp H   &kp J   &kp K               &kp L    &kp SEMI  &kp SQT
&kp LCTRL       &hrm LC(Z) Z  &hrm LC(X) X  &hrm LC(C) C  &hrm LC(V) V  &kp B   &none        &none    &kp N   &kp M   &kp COMMA           &kp DOT  &kp FSLH  &lt 3 BACKSLASH
                                            &kp LEFT_GUI  &kp LEFT_ALT  &to 1   &kp SPACE    &kp RET  &mo 5   &to 2   &kp K_CONTEXT_MENU
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Navigation {
            bindings = <
&trans  &none   &none   &none   &none   &none                    &none       &none           &none           &none      &none  &none
&trans  &none   &none   &none   &none   &none                    &kp DELETE  &kp HOME        &kp UP_ARROW    &kp END    &none  &trans
&trans  &none   &none   &none   &none   &none                    &kp INSERT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &none  &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &none  &none     &none   &none       &none           &none           &none      &none  &kp RIGHT_CONTROL
                        &trans  &trans  &to 0  &trans    &trans  &trans      &trans          &trans
            >;
        };

        Num {
            bindings = <
&trans  &none  &none  &none            &none            &none                    &none      &none            &none            &none            &none       &none
&trans  &none  &none  &kp KP_PLUS      &kp KP_SUBTRACT  &none                    &Colon     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none       &trans
&trans  &none  &none  &kp KP_MULTIPLY  &kp KP_DIVIDE    &none                    &Dot       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none       &none
&trans  &none  &none  &none            &none            &none  &none     &none   &kp KP_N0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT  &none
                      &trans           &trans           &to 0  &trans    &trans  &trans     &trans           &trans
            >;
        };

        F_layer {
            bindings = <
&trans  &none  &none  &none   &none   &none                     &none   &none   &none    &none    &none    &none
&trans  &none  &none  &none   &none   &none                     &none   &kp F9  &kp F10  &kp F11  &kp F12  &none
&trans  &none  &none  &none   &none   &none                     &none   &kp F5  &kp F6   &kp F7   &kp F8   &none
&trans  &none  &none  &none   &none   &none   &none     &none   &none   &kp F1  &kp F2   &kp F3   &kp F4   &none
                      &trans  &trans  &trans  &trans    &trans  &trans  &none   &none
            >;
        };

        BtAndMedia {
            bindings = <
&none  &none  &none  &none         &none         &none                   &none  &none            &none              &none       &none  &none
&none  &none  &none  &bt BT_SEL 1  &bt BT_SEL 0  &none                   &none  &kp K_PREVIOUS   &kp K_PLAY_PAUSE   &kp K_NEXT  &none  &none
&none  &none  &none  &none         &none         &none                   &none  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_MUTE  &none  &none
&none  &none  &none  &none         &none         &none   &none    &none  &none  &none            &none              &none       &none  &none
                     &none         &none         &trans  &none    &none  &none  &none            &none
            >;
        };

        ChooseYourLayer {
            bindings = <
&none  &none  &none  &none  &none  &none                   &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                   &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &to 4  &none                   &none  &to 1  &to 2  &to 3  &none  &none
&none  &none  &none  &none  &none  &none   &none    &none  &none  &none  &none  &none  &none  &none
                     &none  &none  &trans  &none    &none  &none  &none  &none
            >;
        };
    };
};
